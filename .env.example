# ---------------- App ----------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production
PORT=3000

# Test mode: skips email verification, enables test card payments and /api/test/* helpers.
# TEST_MODE is read at runtime by the server; NEXT_PUBLIC_TEST_MODE is baked into the client bundle.
NEXT_PUBLIC_TEST_MODE=true
TEST_MODE=true

# Maintenance mode: non-admin visitors see /maintenance (HTTP 503)
MAINTENANCE_MODE=false

# Extra origins allowed to call the API with credentials (comma-separated, or *). Same-origin is always allowed.
CORS_ALLOWED_ORIGINS=

# Rate limiting (set false for automated test runs)
RATE_LIMIT_ENABLED=false

# ---------------- Database ----------------
POSTGRES_USER=nexashop
POSTGRES_PASSWORD=nexashop
POSTGRES_DB=nexashop
DATABASE_URL=postgresql://nexashop:nexashop@localhost:5432/nexashop?schema=public

# Seed behaviour on container start: if-empty | always | never
SEED_MODE=if-empty

# ---------------- Auth ----------------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
LOCKOUT_MINUTES=15

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------- Payments (Stripe test mode, optional) ----------------
# When set AND TEST_MODE=false, checkout uses Stripe Payment Element.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------- Email ----------------
# Leave SMTP_HOST empty to use the mock JSON transport (emails are still logged to DB).
# docker-compose points this at Mailpit (UI: http://localhost:8025).
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NexaShop <no-reply@nexashop.test>"

# ---------------- Storage ----------------
UPLOAD_DIR=./uploads
